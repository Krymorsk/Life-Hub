rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function ownsNew() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId}/{document=**} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId && ownsNew();
      allow update: if signedIn() && request.auth.uid == userId &&
        (ownsExisting() || ownsNew());
      allow delete: if signedIn() && request.auth.uid == userId && ownsExisting();
    }
  }
}
